<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Not part of the build: run `mvn install` at the top of the repository first. -->
  <groupId>io.github.complydoc</groupId>
  <artifactId>complydoc4j-sample-langchain4j</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>complydoc4j sample: a LangChain4j ingestion, observed</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <langchain4j.version>1.23.0</langchain4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.complydoc</groupId>
      <artifactId>complydoc4j-langchain4j</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <dependency>
      <!-- Reads PDFs for LangChain4j; complydoc4j reads them with PDFBox too. -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-document-parser-apache-pdfbox</artifactId>
      <version>${langchain4j.version}-beta33</version>
    </dependency>
    <dependency>
      <!-- An embedding model that runs in the process: nothing leaves the machine. -->
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
      <version>${langchain4j.version}-beta33</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <mainClass>sample.Ingest</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
